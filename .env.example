DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,p6-backup-admin-web,p6operations.axialprojects.com,194.164.91.107
CSRF_TRUSTED_ORIGINS=http://localhost:8026,http://194.164.91.107:8026,https://p6operations.axialprojects.com

# Generate with:
# python -c "from cryptography.fernet import Fernet; import json; print(json.dumps([Fernet.generate_key().decode()]))"
BACKUP_ENCRYPTION_KEYS=[]
BACKUP_KEEP_LOCAL=false
BACKUP_VERIFY_SHAREPOINT_UPLOAD=false

# SQL Server passwords are read from env vars referenced by each BackupTarget.
P6_AXIALP6_SQL_PASSWORD=
P6_P62212_SQL_PASSWORD=
P6_DEFAULT_SQL_HOST=host.docker.internal
P6_AXIALP6_SQL_PORT=1466
P6_P62212_SQL_PORT=1433

# PostgreSQL reporting credentials are held in a private JSON file, outside SQLite.
# With compose.reporting.yml these are container paths in the read-only runtime mount.
P6_REPORTING_CONFIG_FILE=/stage/reporting-secrets.json
# Required only when using compose.reporting.yml; choose an existing private directory.
# P6_REPORTING_RUNTIME_DIR=/absolute/private/p6-reporting
# P6_REPORTING_NETWORK=p6-reporting
# Keep the retired SQL refresh disabled. PostgreSQL scheduling is managed in Reporting Database.
P6_SCHEDULE_QUALITY_REFRESH_ENABLED=false

# Optional reporting capacity: enabled automatically when reporting_mirror is installed.
# P6_REPORTING_CAPACITY_ENABLED=true
# Path must be verified to share PostgreSQL's data filesystem; never use the web overlay.
# Production P6-Standby uses the existing read-only /stage bind on the same host disk.
P6_REPORTING_CAPACITY_STORAGE_PATH=

# Microsoft Graph app registration with Sites.ReadWrite.All and Mail.Send if using Graph email.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_SENDER=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=p6-backups@example.local
